+
+void VulkanCommandProcessor::BeginOcclusionQuerySegment() {
+  ActiveOcclusionQuery& query = active_occlusion_query_;
+  if (!query.valid || !query.in_render_passes || query.host_index != UINT32_MAX ||
+      !in_guest_render_pass_ || occlusion_query_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  // Indices used in the open submission are only reset at its end, so they can't wrap here.
+  if (occlusion_query_cursor_ >= kMaxOcclusionQueries) {
+    query.incomplete = true;
+    return;
+  }
+  query.host_index = occlusion_query_cursor_++;
+  query.segments.push_back(query.host_index);
+  deferred_command_buffer_.CmdVkBeginQuery(occlusion_query_pool_, query.host_index, 0);
+}
+
+void VulkanCommandProcessor::EndOcclusionQuerySegment() {
+  ActiveOcclusionQuery& query = active_occlusion_query_;
+  if (!query.valid || !query.in_render_passes || query.host_index == UINT32_MAX) {
+    return;
+  }
+  deferred_command_buffer_.CmdVkEndQuery(occlusion_query_pool_, query.host_index);
+  query.host_index = UINT32_MAX;
+}
+
+void VulkanCommandProcessor::CopyAndResetSubmissionOcclusionQueries() {
+  uint32_t first = occlusion_query_submission_first_;
+  occlusion_query_submission_first_ = occlusion_query_cursor_;
+  if (occlusion_query_pool_ == VK_NULL_HANDLE || occlusion_query_cursor_ <= first) {
+    return;
+  }
+  // Also covers queries recorded outside passes, which already copied and are reset before reuse.
+  uint32_t count = occlusion_query_cursor_ - first;
+  deferred_command_buffer_.CmdVkCopyQueryPoolResults(
+      occlusion_query_pool_, first, count, occlusion_query_readback_buffer_,
+      sizeof(uint64_t) * first, sizeof(uint64_t),
+      VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+  VkMemoryBarrier memory_barrier = {};
+  memory_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  memory_barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  memory_barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  deferred_command_buffer_.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                                VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1,
+                                                &memory_barrier, 0, nullptr, 0, nullptr);
+  deferred_command_buffer_.CmdVkResetQueryPool(occlusion_query_pool_, first, count);
+  memory_barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  deferred_command_buffer_.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                                VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &memory_barrier,
+                                                0, nullptr, 0, nullptr);
 }
 
