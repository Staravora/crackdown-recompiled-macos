                     "Use VK_KHR_dynamic_rendering for Vulkan GPU emulation when supported by the "
                     "device (falls back to render passes otherwise)")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(vulkan_log_pass_breaks, false, "GPU/Vulkan",
+                    "Log why render passes end, every 60 frames (diagnostic)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+#include <dlfcn.h>
+#include <map>
+
+namespace {
+
+// Diagnostic only: render pass ends keyed by the code that caused them. Only the
+// command processor thread touches these.
+struct PassBreakStats {
+  uint64_t frames = 0;
+  uint64_t submissions = 0;
+  uint64_t framebuffer_switches = 0;
+  std::map<const void*, uint64_t> end_callers;
+  std::map<const void*, uint64_t> barrier_callers;
+};
+PassBreakStats g_pass_breaks;
+
+std::string DescribeCodeAddress(const void* address) {
+  Dl_info info;
+  if (dladdr(address, &info) && info.dli_fname) {
+    const char* name = std::strrchr(info.dli_fname, '/');
+    return fmt::format("{}+0x{:x}", name ? name + 1 : info.dli_fname,
+                       uintptr_t(address) - uintptr_t(info.dli_fbase));
+  }
+  return fmt::format("0x{:x}", uintptr_t(address));
+}
+
+void LogPassBreaks() {
+  PassBreakStats& stats = g_pass_breaks;
+  uint64_t ends = stats.framebuffer_switches;
+  for (const auto& [caller, count] : stats.end_callers) {
+    ends += count;
+  }
+  REXGPU_INFO("Pass breaks: {:.1f}/frame, {:.1f} submissions/frame, {:.1f} framebuffer switches/frame",
+              double(ends) / stats.frames, double(stats.submissions) / stats.frames,
+              double(stats.framebuffer_switches) / stats.frames);
+  for (const auto& [caller, count] : stats.end_callers) {
+    REXGPU_INFO("  EndRenderPass from {}: {:.1f}/frame", DescribeCodeAddress(caller),
+                double(count) / stats.frames);
+  }
+  for (const auto& [caller, count] : stats.barrier_callers) {
+    REXGPU_INFO("  SubmitBarriers from {}: {:.1f}/frame", DescribeCodeAddress(caller),
+                double(count) / stats.frames);
+  }
+  stats = {};
+}
+
+}  // namespace
 
