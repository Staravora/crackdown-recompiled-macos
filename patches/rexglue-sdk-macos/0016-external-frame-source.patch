+// A renderer outside the emulator can supply the picture each swap presents. size gives the size of its newest frame, or
+// returns false if there's none yet. fill copies that frame as BGRA8, row_bytes apart, and returns false if it no longer
+// has one of that size. Both run on the command processor thread, at the swap.
+using RexExternalFrameSizeFn = bool (*)(void* context, uint32_t* width, uint32_t* height);
+using RexExternalFrameFillFn = bool (*)(void* context, void* pixels, uint32_t row_bytes, uint32_t width, uint32_t height);
+
 namespace {
 
+std::mutex g_external_frame_mutex;
+RexExternalFrameSizeFn g_external_frame_size = nullptr;
+RexExternalFrameFillFn g_external_frame_fill = nullptr;
+void* g_external_frame_context = nullptr;
+
+}  // namespace
+
+extern "C" REX_GPU_PLUGIN_EXPORT void rex_gpu_set_external_frame_source(RexExternalFrameSizeFn size,
+                                                                        RexExternalFrameFillFn fill,
+                                                                        void* context) {
+  std::lock_guard lock(g_external_frame_mutex);
+  g_external_frame_size = size;
+  g_external_frame_fill = fill;
+  g_external_frame_context = context;
+}
