diff --git a/src/graphics/pipeline/shader/spirv_translator.cpp b/src/graphics/pipeline/shader/spirv_translator.cpp
--- a/src/graphics/pipeline/shader/spirv_translator.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator.cpp
@@ -30,6 +30,21 @@
 // SPIRV-Cross treats the SampleRateShading capability as a request to run the
 // whole fragment shader per sample on Metal, so declaring it only for the
 // alpha to coverage sample mask output multiplies fragment work under MSAA.
+REXCVAR_DEFINE_BOOL(vulkan_contract_pixel_shader_math, false, "GPU/Vulkan",
+                    "Let the backend compiler fuse and reorder floating-point math in pixel "
+                    "shaders (fewer registers on Metal, possibly slightly different results)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+REXCVAR_DEFINE_BOOL(vulkan_contract_vertex_shader_math, false, "GPU/Vulkan",
+                    "Let the backend compiler fuse and reorder floating-point math in vertex "
+                    "shaders, keeping the position invariant across shaders instead")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+REXCVAR_DEFINE_BOOL(vulkan_plain_multiply, false, "GPU/Vulkan",
+                    "Translate multiplications as plain IEEE multiplications rather than "
+                    "emulating Xenos 0 * anything = 0 (experimental, may change visuals)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 REXCVAR_DEFINE_BOOL(vulkan_pixel_rate_alpha_to_coverage, false, "GPU/Vulkan",
                     "Don't declare SampleRateShading for the alpha to coverage sample mask "
                     "output (avoids per-sample shading on MoltenVK)")
@@ -184,6 +199,9 @@
   // TODO(Triang3l): Logger.
   builder_ = std::make_unique<SpirvBuilder>(features_.spirv_version, (kSpirvMagicToolId << 16) | 1,
                                             nullptr);
+  builder_->allow_contraction =
+      is_pixel_shader() ? REXCVAR_GET(vulkan_contract_pixel_shader_math)
+                        : REXCVAR_GET(vulkan_contract_vertex_shader_math);
 
   builder_->addCapability(IsSpirvTessEvalShader() ? spv::CapabilityTessellation
                                                   : spv::CapabilityShader);
@@ -1759,6 +1777,12 @@
   builder_->addMemberName(type_struct_per_vertex, kOutputPerVertexMemberPosition, "gl_Position");
   builder_->addMemberDecoration(type_struct_per_vertex, kOutputPerVertexMemberPosition,
                                 spv::DecorationBuiltIn, spv::BuiltInPosition);
+  if (builder_->allow_contraction) {
+    // Without NoContraction, the position must still be computed identically
+    // by different shaders so multipass rendering doesn't z-fight.
+    builder_->addMemberDecoration(type_struct_per_vertex, kOutputPerVertexMemberPosition,
+                                  spv::DecorationInvariant);
+  }
   if (output_per_vertex_member_clip_distance_ != UINT32_MAX) {
     builder_->addMemberName(type_struct_per_vertex, output_per_vertex_member_clip_distance_,
                             "gl_ClipDistance");
