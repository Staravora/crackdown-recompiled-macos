+// The newest fence a renderer outside the emulator has finished. Set means that renderer draws.
+std::atomic<bool> g_external_fences{false};
+std::atomic<uint32_t> g_external_fence_done{0};
+std::atomic<rex::graphics::CommandProcessor*> g_external_fence_holder{nullptr};
+
+}  // namespace
+
+extern "C" REX_GPU_PLUGIN_EXPORT void rex_gpu_set_external_fence_done(uint32_t done) {
+  g_external_fence_done.store(done, std::memory_order_release);
+  g_external_fences.store(true, std::memory_order_release);
+  if (rex::graphics::CommandProcessor* holder = g_external_fence_holder.load(std::memory_order_acquire)) {
+    holder->ReleaseHeldWrites();
+  }
+}
