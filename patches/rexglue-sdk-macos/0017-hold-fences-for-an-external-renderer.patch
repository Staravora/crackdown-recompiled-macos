+void CommandProcessor::HoldOrWrite(uint32_t address, uint32_t value, uint32_t tag) {
+  if (!g_external_fences.load(std::memory_order_acquire)) {
+    memory::store(memory_->TranslatePhysical(address), value);
+    WakeGuestWordWaiters(memory_->TranslatePhysical(address));
+    return;
+  }
+  g_external_fence_holder.store(this, std::memory_order_release);
+  {
+    std::lock_guard lock(held_writes_mutex_);
+    held_writes_.push_back({address, value, tag});
+  }
+  ReleaseHeldWrites();
+}
+
+void CommandProcessor::ReleaseHeldWrites() {
+  std::lock_guard lock(held_writes_mutex_);
+  const uint32_t done = g_external_fence_done.load(std::memory_order_acquire);
+  while (!held_writes_.empty() && int32_t(done - held_writes_.front().tag) >= 0) {
+    const HeldWrite& write = held_writes_.front();
+    memory::store(memory_->TranslatePhysical(write.address), write.value);
+    WakeGuestWordWaiters(memory_->TranslatePhysical(write.address));
+    held_writes_.pop_front();
+  }
+}
