 void DeferredCommandBuffer::Execute(VkCommandBuffer command_buffer) {
+  static thread_local bool reported_render_area_mode = false;
+  if (!reported_render_area_mode) {
+    reported_render_area_mode = true;
+    REXGPU_INFO("Bounded render areas: {}", REXCVAR_GET(vulkan_trim_render_areas));
+  }
+  if (REXCVAR_GET(vulkan_trim_render_areas)) {
+    // The complete pass is recorded before replay, so include all its draws
+    // before selecting the render area. Never shrink around an attachment
+    // clear, an unknown scissor, or suspended/secondary rendering.
+    RenderAreaBounds bounds;
+    static thread_local uint64_t original_pixels = 0, bounded_pixels = 0, passes = 0;
+    static thread_local auto last_report = std::chrono::steady_clock::now();
+    VkRect2D* active_area = nullptr;
+    auto finish = [&] {
+      if (active_area) {
+        original_pixels += uint64_t(active_area->extent.width) * active_area->extent.height;
+        *active_area = bounds.End();
+        bounded_pixels += uint64_t(active_area->extent.width) * active_area->extent.height;
+        ++passes;
+      }
+      active_area = nullptr;
+    };
+    auto* scan = command_stream_.data();
+    size_t remaining = command_stream_.size();
+    while (remaining) {
+      const auto header = *reinterpret_cast<const CommandHeader*>(scan);
+      scan += kCommandHeaderSizeElements;
+      remaining -= kCommandHeaderSizeElements;
+      switch (header.command) {
+        case Command::kVkBeginRenderPass: {
+          finish();
+          auto& args = *reinterpret_cast<ArgsVkBeginRenderPass*>(scan);
+          active_area = &args.render_area;
+          bounds.Begin(*active_area, args.clear_value_count == 0 &&
+                                        args.contents == VK_SUBPASS_CONTENTS_INLINE);
+        } break;
+        case Command::kVkBeginRendering: {
+          finish();
+          auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(scan);
+          size_t offset = rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo));
+          const auto* attachments = reinterpret_cast<const VkRenderingAttachmentInfo*>(
+              reinterpret_cast<const uint8_t*>(scan) + offset);
+          uint32_t count = args.color_attachment_count + uint32_t(args.has_depth_attachment) +
+                           uint32_t(args.has_stencil_attachment);
+          bool can_trim = args.flags == 0;
+          for (uint32_t i = 0; i < count; ++i) {
+            if (attachments[i].imageView != VK_NULL_HANDLE &&
+                (attachments[i].loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR ||
+                 attachments[i].resolveMode != VK_RESOLVE_MODE_NONE)) can_trim = false;
+          }
+          active_area = &args.render_area;
+          bounds.Begin(*active_area, can_trim);
+        } break;
+        case Command::kVkSetScissor: {
+          const auto& args = *reinterpret_cast<const ArgsVkSetScissor*>(scan);
+          const size_t offset = rex::align(sizeof(ArgsVkSetScissor), alignof(VkRect2D));
+          bounds.SetScissor(args.first_scissor, args.scissor_count,
+              reinterpret_cast<const VkRect2D*>(reinterpret_cast<const uint8_t*>(scan) + offset));
+        } break;
+        case Command::kVkDraw:
+        case Command::kVkDrawIndexed:
+          if (active_area) bounds.Draw();
+          break;
+        case Command::kVkEndRenderPass:
+        case Command::kVkEndRendering:
+          finish();
+          break;
+        default:
+          break;
+      }
+      scan += header.arguments_size_elements;
+      remaining -= header.arguments_size_elements;
+    }
+    finish();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_report >= std::chrono::seconds(1)) {
+      REXGPU_INFO("Render areas: {} passes, {:.1f}% of original load/store pixels", passes,
+                    original_pixels ? 100.0 * double(bounded_pixels) / double(original_pixels) : 100.0);
+      passes = original_pixels = bounded_pixels = 0;
+      last_report = now;
+    }
+  }
 #if XE_GPU_FINE_GRAINED_DRAW_SCOPES
   SCOPE_profile_cpu_f("gpu");
 #endif  // XE_GPU_FINE_GRAINED_DRAW_SCOPES
