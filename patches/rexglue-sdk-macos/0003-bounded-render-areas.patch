diff --git a/include/rex/graphics/vulkan/render_area.h b/include/rex/graphics/vulkan/render_area.h
--- /dev/null
+++ b/include/rex/graphics/vulkan/render_area.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <vulkan/vulkan.h>
+
+namespace rex::graphics::vulkan {
+
+// Conservative attachment load/store bounds. Scissor state persists between
+// passes; accumulate only scissors used by a draw, including later expansions.
+class RenderAreaBounds {
+ public:
+  void SetScissor(uint32_t first, uint32_t count, const VkRect2D* rectangles) {
+    if (first != 0 || count != 1) {
+      unsupported_scissors_ = true;
+      return;
+    }
+    scissor_ = rectangles[0];
+  }
+
+  void Begin(VkRect2D original, bool can_trim) {
+    original_ = original;
+    bounds_.reset();
+    can_trim_ = can_trim;
+  }
+
+  void Draw() {
+    if (!scissor_ || unsupported_scissors_) {
+      can_trim_ = false;
+      return;
+    }
+    const int64_t x0 = std::max<int64_t>(original_.offset.x, scissor_->offset.x);
+    const int64_t y0 = std::max<int64_t>(original_.offset.y, scissor_->offset.y);
+    const int64_t x1 = std::min(int64_t(original_.offset.x) + original_.extent.width,
+                              int64_t(scissor_->offset.x) + scissor_->extent.width);
+    const int64_t y1 = std::min(int64_t(original_.offset.y) + original_.extent.height,
+                              int64_t(scissor_->offset.y) + scissor_->extent.height);
+    if (x1 <= x0 || y1 <= y0) return;
+    if (!bounds_) {
+      bounds_ = VkRect2D{{int32_t(x0), int32_t(y0)}, {uint32_t(x1-x0), uint32_t(y1-y0)}};
+      return;
+    }
+    const int64_t left = std::min<int64_t>(bounds_->offset.x, x0);
+    const int64_t top = std::min<int64_t>(bounds_->offset.y, y0);
+    const int64_t right = std::max(int64_t(bounds_->offset.x) + bounds_->extent.width, x1);
+    const int64_t bottom = std::max(int64_t(bounds_->offset.y) + bounds_->extent.height, y1);
+    bounds_ = VkRect2D{{int32_t(left), int32_t(top)},
+                       {uint32_t(right-left), uint32_t(bottom-top)}};
+  }
+
+  VkRect2D End() const { return can_trim_ && bounds_ ? *bounds_ : original_; }
+
+ private:
+  std::optional<VkRect2D> scissor_;
+  std::optional<VkRect2D> bounds_;
+  VkRect2D original_{};
+  bool can_trim_ = false;
+  bool unsupported_scissors_ = false;
+};
+
+}  // namespace rex::graphics::vulkan
