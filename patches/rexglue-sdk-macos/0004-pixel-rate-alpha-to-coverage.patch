diff --git a/src/graphics/pipeline/shader/spirv_translator.cpp b/src/graphics/pipeline/shader/spirv_translator.cpp
--- a/src/graphics/pipeline/shader/spirv_translator.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator.cpp
@@ -21,10 +21,19 @@
 #include <fmt/format.h>
 
 #include <rex/assert.h>
+#include <rex/cvar.h>
 #include <rex/graphics/pipeline/shader/spirv.h>
 #include <rex/graphics/pipeline/shader/spirv_translator.h>
 #include <rex/math.h>
 #include <rex/string/buffer.h>
+
+// SPIRV-Cross treats the SampleRateShading capability as a request to run the
+// whole fragment shader per sample on Metal, so declaring it only for the
+// alpha to coverage sample mask output multiplies fragment work under MSAA.
+REXCVAR_DEFINE_BOOL(vulkan_pixel_rate_alpha_to_coverage, false, "GPU/Vulkan",
+                    "Don't declare SampleRateShading for the alpha to coverage sample mask "
+                    "output (avoids per-sample shading on MoltenVK)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
 namespace rex::graphics {
 
@@ -2922,7 +2931,8 @@
 
   // Sample mask input.
   if (edram_fragment_shader_interlock_ || IsSampleRate() ||
-      (alpha_to_coverage_possible && features_.sample_rate_shading)) {
+      (alpha_to_coverage_possible && features_.sample_rate_shading &&
+       !REXCVAR_GET(vulkan_pixel_rate_alpha_to_coverage))) {
     // SampleMask depends on SampleRateShading in some SPIR-V revisions.
     builder_->addCapability(spv::CapabilitySampleRateShading);
   }
