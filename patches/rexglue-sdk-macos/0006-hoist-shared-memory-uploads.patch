+
+void VulkanCommandProcessor::NoteRenderPassSharedMemoryAccess(uint32_t start, uint32_t length) {
+  if (render_pass_hoist_point_ == UINT32_MAX || !length) {
+    return;
+  }
+  uint32_t end = start + std::min(length, SharedMemory::kBufferSize - start);
+  // Draws commonly touch the same or neighboring ranges - extend the last one.
+  if (!render_pass_shared_memory_accesses_.empty()) {
+    auto& last = render_pass_shared_memory_accesses_.back();
+    if (start <= last.second && end >= last.first) {
+      last.first = std::min(last.first, start);
+      last.second = std::max(last.second, end);
+      return;
+    }
+  }
+  render_pass_shared_memory_accesses_.emplace_back(start, end);
+}
+
+DeferredCommandBuffer::HoistPoint* VulkanCommandProcessor::GetSharedMemoryUploadHoistPoint(
+    uint32_t start, uint32_t length) {
+  if (!in_render_pass_ || render_pass_hoist_point_ == UINT32_MAX) {
+    return nullptr;
+  }
+  bool log_pass_breaks = REXCVAR_GET(vulkan_log_pass_breaks);
+  if (!shared_memory_upload_hoisting_allowed_) {
+    g_pass_breaks.uploads_not_in_draw += log_pass_breaks;
+    return nullptr;
+  }
+  uint32_t end = start + length;
+  for (const auto& access : render_pass_shared_memory_accesses_) {
+    if (start < access.second && end > access.first) {
+      if (log_pass_breaks) {
+        ++g_pass_breaks.uploads_overlapping;
+        g_pass_breaks.uploads_overlapping_whole_buffer +=
+            access.second - access.first >= SharedMemory::kBufferSize;
+        g_pass_breaks.upload_overlap_bytes += access.second - access.first;
+      }
+      return nullptr;
+    }
+  }
+  g_pass_breaks.uploads_hoisted += log_pass_breaks;
+  return &deferred_command_buffer_.hoist_point(render_pass_hoist_point_);
 }
 
