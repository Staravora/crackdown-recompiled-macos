+
+void VulkanCommandProcessor::ServiceExternalWork() {
+  const uint64_t request = g_external_present_request.exchange(0, std::memory_order_acq_rel);
+  if (!(request >> 63)) {
+    return;
+  }
+  presenting_external_frame_ = true;
+  IssueSwap(0, uint32_t(request >> 32) & 0x7FFFFFFF, uint32_t(request));
+  presenting_external_frame_ = false;
 }
 
