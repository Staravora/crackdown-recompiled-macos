 }  // namespace
 
+namespace {
+
+// An external renderer that paces its own presents, and its newest request: the guest front buffer's size, or 0.
+std::atomic<bool> g_external_present_paced{false};
+std::atomic<uint64_t> g_external_present_request{0};
+std::atomic<rex::graphics::vulkan::VulkanCommandProcessor*> g_external_present_processor{nullptr};
+
+}  // namespace
+
+// With paced set, the guest's swaps present nothing, and the external renderer presents with rex_gpu_present_external_frame,
+// which takes the front buffer's size, as a swap would.
+extern "C" REX_GPU_PLUGIN_EXPORT void rex_gpu_set_external_present_paced(bool paced) {
+  g_external_present_paced.store(paced, std::memory_order_release);
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT void rex_gpu_present_external_frame(uint32_t width, uint32_t height) {
+  g_external_present_request.store(uint64_t(width) << 32 | height | (uint64_t(1) << 63), std::memory_order_release);
+  if (auto* processor = g_external_present_processor.load(std::memory_order_acquire)) {
+    processor->WakeWorker();
+  }
+}
