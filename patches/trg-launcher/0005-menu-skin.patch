+    if (clicked) want_play_ = true;
+  }
+
+  // The middle: a status line while one shows, else the help of the row under the mouse, else the page's own line.
+  const bool show_status = !status_.empty() && ImGui::GetTime() < status_until_;
+  const std::string& text = show_status       ? status_
+                            : !hover_help_.empty() ? hover_help_
+                            : config_.pages.empty() ? config_.note
+                                                    : config_.pages[size_t(page_)].blurb;
+  const float left = x + 8 * s, right = quit_x - 24 * s, fs = 19 * s;
+  if (right > left && !text.empty()) {
+    const ImVec2 ts = config_.fonts.regular->CalcTextSizeA(fs, right - left, right - left, text.c_str());
+    dl->PushClipRect(ImVec2(left, a.y), ImVec2(right, b.y), true);
+    const float tx = std::max(left, left + (right - left - ts.x) * 0.5f);
+    dl->AddText(config_.fonts.regular, fs, ImVec2(tx, cy - ts.y * 0.5f + 1), IM_COL32(0, 0, 0, 150), text.c_str(), nullptr,
+                right - left);
+    dl->AddText(config_.fonts.regular, fs, ImVec2(tx, cy - ts.y * 0.5f), k.help_text, text.c_str(), nullptr, right - left);
+    dl->PopClipRect();
+  }
+}
