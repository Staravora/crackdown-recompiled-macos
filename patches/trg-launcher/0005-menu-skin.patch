+// ---------------------------------------------------------- skin drawing --
+// A rectangle with its top-left corner cut at `chamfer` and its bottom edge `slant` short on the right, clockwise as
+// ImGui's anti-aliased fill wants.
+struct Shape {
+  ImVec2 p[5];
+};
+Shape Chamfered(ImVec2 a, ImVec2 b, float chamfer, float slant = 0.0f) {
+  return {{ImVec2(a.x + chamfer, a.y), ImVec2(b.x, a.y), ImVec2(b.x - slant, b.y), ImVec2(a.x, b.y), ImVec2(a.x, a.y + chamfer)}};
+}
+
+// Keeps the part of a convex polygon between y0 and y1.
+std::vector<ImVec2> ClipBand(const ImVec2* in, int n, float y0, float y1) {
+  std::vector<ImVec2> poly(in, in + n), out;
+  for (int edge = 0; edge < 2; ++edge) {
+    const float y = edge ? y1 : y0;
+    const auto inside = [&](const ImVec2& p) { return edge ? p.y <= y : p.y >= y; };
+    out.clear();
+    for (size_t i = 0; i < poly.size(); ++i) {
+      const ImVec2 a = poly[i], b = poly[(i + 1) % poly.size()];
+      if (inside(a)) out.push_back(a);
+      if (inside(a) != inside(b)) {
+        const float t = (y - a.y) / (b.y - a.y);
+        out.push_back(ImVec2(a.x + (b.x - a.x) * t, y));
+      }
+    }
+    poly.swap(out);
+    if (poly.size() < 3) break;
+  }
+  return poly;
+}
+
+// Fills the part of `shape` between y0 and y1 with a vertical gradient. Clipping first makes the gradient exact, so
+// stacked bands give hard steps such as a gloss line.
+void FillBand(ImDrawList* dl, const Shape& shape, float y0, float y1, ImU32 c0, ImU32 c1) {
+  const std::vector<ImVec2> part = ClipBand(shape.p, 5, y0, y1);
+  if (part.size() < 3) return;
+  const int start = dl->VtxBuffer.Size;
+  dl->AddConvexPolyFilled(part.data(), int(part.size()), c0);
+  ImGui::ShadeVertsLinearColorGradientKeepAlpha(dl, start, dl->VtxBuffer.Size, ImVec2(0, y0), ImVec2(0, y1), c0, c1);
+}
+
+// A soft glow around a shape, standing in for a CSS drop-shadow.
+// Faint filled shapes, each a little larger, so they add up to a halo that fades outwards. The button covers the middle.
+void Glow(ImDrawList* dl, ImVec2 a, ImVec2 b, float chamfer, ImU32 color, float radius) {
+  const int steps = 7;
+  const ImU32 c = (color & ~IM_COL32_A_MASK) | (ImU32(float((color >> IM_COL32_A_SHIFT) & 0xFF) * 0.09f) << IM_COL32_A_SHIFT);
+  for (int i = steps; i >= 1; --i) {
+    const float grow = radius * float(i) / float(steps);
+    const Shape s = Chamfered(ImVec2(a.x - grow, a.y - grow), ImVec2(b.x + grow, b.y + grow), chamfer + grow * 0.4f);
+    dl->AddConvexPolyFilled(s.p, 5, c);
+  }
+}
+
+// A glossy bevelled button face: a border layer, then the face with its hard gloss line between 48% and 52%.
+void GlossFace(ImDrawList* dl, ImVec2 a, ImVec2 b, float chamfer, float border, const GlossLook& look) {
+  const Shape outer = Chamfered(a, b, chamfer);
+  FillBand(dl, outer, a.y, b.y, look.border_top, look.border_bottom);
+  const ImVec2 fa(a.x + border, a.y + border), fb(b.x - border, b.y - border);
+  const Shape face = Chamfered(fa, fb, chamfer - border * 0.5f);
+  const float h = fb.y - fa.y;
+  FillBand(dl, face, fa.y, fa.y + h * 0.48f, look.face_top, look.face_upper);
+  FillBand(dl, face, fa.y + h * 0.48f, fa.y + h * 0.52f, look.face_upper, look.face_lower);
+  FillBand(dl, face, fa.y + h * 0.52f, fb.y, look.face_lower, look.face_bottom);
+}
+
+// An angled tab: a chamfered top-left corner and a slanted right end.
+void Tab(ImDrawList* dl, ImVec2 a, ImVec2 b, float chamfer, float slant, ImU32 top, ImU32 middle, ImU32 bottom) {
+  const Shape s = Chamfered(a, b, chamfer, slant);
+  const float mid = a.y + (b.y - a.y) * 0.6f;
+  FillBand(dl, s, a.y, mid, top, middle);
+  FillBand(dl, s, mid, b.y, middle, bottom);
+}
+
+// A panel: a border, then a body with a vertical gradient and scanlines, all with the top-left corner cut.
+void Panel(ImDrawList* dl, ImVec2 a, ImVec2 b, float chamfer, float border, float scale, const MenuSkin& skin) {
+  FillBand(dl, Chamfered(a, b, chamfer), a.y, b.y, skin.panel_border, skin.panel_border);
+  const ImVec2 ia(a.x + border, a.y + border), ib(b.x - border, b.y - border);
+  const float inner = chamfer - border * 0.5f;
+  FillBand(dl, Chamfered(ia, ib, inner), ia.y, ib.y, skin.panel_top, skin.panel_bottom);
+  for (float y = ia.y + 2 * scale; y < ib.y; y += 4 * scale) {
+    const float x0 = y < ia.y + inner ? ia.x + (inner - (y - ia.y)) : ia.x;
+    dl->AddLine(ImVec2(x0, y), ImVec2(ib.x, y), skin.scanline, 1.0f);
+  }
+}
+
+// Text with a one-pixel drop shadow, as the strip and buttons draw it.
+void ShadowText(ImDrawList* dl, ImFont* font, float size, ImVec2 pos, ImU32 color, const char* text,
+                ImU32 shadow = IM_COL32(0, 0, 0, 128)) {
+  dl->AddText(font, size, ImVec2(pos.x, pos.y + 1), shadow, text);
+  dl->AddText(font, size, pos, color, text);
+}
