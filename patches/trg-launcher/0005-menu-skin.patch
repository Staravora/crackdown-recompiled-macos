+// A glossy button that takes input; true when clicked. Keyboard and controller focus look selected, as in the game.
+bool GlossButton(const MenuSkin& skin, const char* label, ImVec2 size, bool selected, ImFont* font, float font_size,
+                 float s, bool muted = false, bool centre = false) {
+  const ImVec2 a = ImGui::GetCursorScreenPos();
+  const bool clicked = ImGui::InvisibleButton(label, size);
+  const bool hot = ImGui::IsItemHovered() || ImGui::IsItemActive();
+  const bool focused = ImGui::IsItemFocused() && ImGui::GetIO().NavVisible;
+  const GlossLook& look = selected || focused ? skin.selected : hot ? skin.hot : muted ? skin.muted : skin.normal;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  const ImVec2 b(a.x + size.x, a.y + size.y);
+  if (selected || focused) Glow(dl, a, b, 12 * s, skin.glow, 7 * s);
+  GlossFace(dl, a, b, 12 * s, 2 * s, look);
+  const char* end = ImGui::FindRenderedTextEnd(label);
+  const ImVec2 ts = font->CalcTextSizeA(font_size, FLT_MAX, 0.0f, label, end);
+  const float x = centre ? a.x + (size.x - ts.x) * 0.5f : a.x + 16 * s;
+  const float y = a.y + (size.y - ts.y) * 0.5f;
+  dl->AddText(font, font_size, ImVec2(x, y + 1), IM_COL32(0, 0, 0, 128), label, end);
+  dl->AddText(font, font_size, ImVec2(x, y), look.text, label, end);
+  return clicked;
+}
