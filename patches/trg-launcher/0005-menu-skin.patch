+// ------------------------------------------------------------ skin layout --
+void Launcher::DrawSkinned(ImVec2 origin, float w, float h) {
+  const MenuSkin& k = config_.skin;
+  const float s = s_;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  const ImVec2 max(origin.x + w, origin.y + h);
+  const HeaderContext ctx{dl, origin, max, float(ImGui::GetTime()), s, config_.theme};
+  if (k.backdrop) {
+    k.backdrop(ctx);
+  } else {
+    dl->AddRectFilledMultiColor(origin, max, k.tab_bottom, k.tab_bottom, k.strip_bottom, k.strip_bottom);
+  }
+  dl->AddRectFilledMultiColor(origin, max, k.shade_top, k.shade_top, k.shade_bottom, k.shade_bottom);
+
+  const float header = 92 * s, strip = 104 * s, side = 32 * s, nav_w = 290 * s, gap = 22 * s;
+  DrawSkinnedHeader(origin, w, header);
+  const float top = origin.y + header + 4 * s, bottom = max.y - strip - 22 * s;
+  DrawSkinnedNav(ImVec2(origin.x + side, top), ImVec2(origin.x + side + nav_w, bottom));
+  DrawSkinnedContent(ImVec2(origin.x + side + nav_w + gap, top), ImVec2(max.x - side, bottom));
+  DrawSkinnedStrip(ImVec2(origin.x, max.y - strip), w, strip);
+}
+
+void Launcher::DrawSkinnedHeader(ImVec2 origin, float w, float h) {
+  const MenuSkin& k = config_.skin;
+  const Branding& b = config_.branding;
+  const float s = s_;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  ImFont* display = k.display ? k.display : config_.fonts.bold;
+  const float size = 34 * s, bottom = origin.y + h - 14 * s;
+  const float y = bottom - size;
+  dl->PushClipRect(origin, ImVec2(origin.x + w, origin.y + h), true);
+  // The title, two pixels apart a letter, with a blue glow and a drop shadow.
+  const auto title = [&](float x0, float dy, ImU32 color) {
+    float x = x0;
+    for (const char* c = b.title.c_str(); *c;) {
+      unsigned int ch = 0;
+      const char* next = c + ImTextCharFromUtf8(&ch, c, nullptr);
+      dl->AddText(display, size, ImVec2(x, y + dy), color, c, next);
+      x += display->CalcTextSizeA(size, FLT_MAX, 0.0f, c, next).x + 2 * s;
+      c = next;
+    }
+    return x;
+  };
+  const float x0 = origin.x + 32 * s;
+  const ImU32 halo = (k.title_glow & ~IM_COL32_A_MASK) | IM_COL32(0, 0, 0, 40);
+  for (int i = 0; i < 8; ++i) {
+    const float a = float(i) * 0.785f;
+    title(x0 + std::cos(a) * 3 * s, std::sin(a) * 3 * s, halo);
+  }
+  title(x0, 2 * s, IM_COL32(0, 0, 0, 150));
+  float x = title(x0, 0.0f, IM_COL32_WHITE) + 20 * s;
+  const float meta = 16 * s, my = bottom - meta - 3 * s;
+  if (b.subtitle_segments.empty()) {
+    ShadowText(dl, config_.fonts.regular, meta, ImVec2(x, my), k.meta_text, b.subtitle.c_str());
+  } else {
+    int n = 0;
+    for (const SubtitleSegment& seg : b.subtitle_segments) {
+      char id[24];
+      std::snprintf(id, sizeof id, "##meta%d", n++);
+      x += LinkText(dl, id, ImVec2(x, my), config_.fonts.regular, meta, seg.url.empty() ? k.meta_text : k.meta_link,
+                    seg.text.c_str(), seg.url);
+    }
+  }
+  dl->PopClipRect();
+}
+
+void Launcher::DrawSkinnedNav(ImVec2 a, ImVec2 b) {
+  const MenuSkin& k = config_.skin;
+  const float s = s_;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  Panel(dl, a, b, 26 * s, 2 * s, s, k);
+  const ImVec2 ta(a.x + 14 * s, a.y + 12 * s), tb(b.x - 14 * s, a.y + 48 * s);
+  Tab(dl, ta, tb, 12 * s, 44 * s, k.tab_top, k.tab_middle, k.tab_bottom);
+  ShadowText(dl, config_.fonts.regular, 21 * s, ImVec2(ta.x + 18 * s, ta.y + 6 * s), k.text, k.nav_title.c_str());
+  float y = tb.y + 12 * s;
+  for (int i = 0; i < int(config_.pages.size()); ++i) {
+    const Page& page = config_.pages[size_t(i)];
+    ImGui::SetCursorScreenPos(ImVec2(ta.x, y));
+    ImGui::PushID(i);
+    if (GlossButton(k, page.name.c_str(), ImVec2(tb.x - ta.x, 40 * s), page_ == i, config_.fonts.regular, 19 * s, s))
+      GoToPage(i);
+    ImGui::PopID();
+    if (page.needs_attention && page.needs_attention())
+      dl->AddCircleFilled(ImVec2(tb.x - 18 * s, y + 20 * s), 5 * s, Col(config_.theme.warn_dot));
+    y += 48 * s;
+  }
+}
+
+void Launcher::DrawSkinnedContent(ImVec2 a, ImVec2 b) {
+  const MenuSkin& k = config_.skin;
+  const float s = s_;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  Panel(dl, a, b, 26 * s, 2 * s, s, k);
+  if (config_.pages.empty()) return;
+  const Page& page = config_.pages[size_t(page_)];
+  const ImVec2 ta(a.x + 14 * s, a.y + 12 * s), tb(b.x - 14 * s, a.y + 48 * s);
+  Tab(dl, ta, tb, 12 * s, 60 * s, k.tab_top, k.tab_middle, k.tab_bottom);
+  ShadowText(dl, config_.fonts.regular, 21 * s, ImVec2(ta.x + 18 * s, ta.y + 6 * s), k.text, page.name.c_str());
+
+  // The page, inset like the tab's title; headings reach back out to the panel's width.
+  ImGui::SetCursorScreenPos(ImVec2(ta.x, tb.y + 14 * s));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+  ImGui::BeginChild("##page_body", ImVec2(tb.x - ta.x, b.y - 18 * s - (tb.y + 14 * s)), ImGuiChildFlags_None);
+  ImGui::PopStyleVar();
+  ImGui::PushFont(config_.fonts.regular, 16 * s);
+  ImGui::PushID(page_);
+  ImGui::Indent(18 * s);
+  ImGui::PushStyleVar(ImGuiStyleVar_CellPadding, ImVec2(0, 6 * s));
+  ImGui::PushTextWrapPos(ImGui::GetContentRegionAvail().x);
+  ui_.BeginPage();
+  if (page.draw) page.draw(ui_);
+  ui_.EndPage();
+  ImGui::PopTextWrapPos();
+  ImGui::PopStyleVar();
+  ImGui::Unindent(18 * s);
+  ImGui::PopID();
+  ImGui::Dummy(ImVec2(0, 8 * s));
+  ImGui::PopFont();
+  ImGui::EndChild();
+}
+
+void Launcher::DrawSkinnedStrip(ImVec2 origin, float w, float h) {
+  const MenuSkin& k = config_.skin;
+  const float s = s_;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  const ImVec2 a = origin, b(origin.x + w, origin.y + h);
+  const Shape band = Chamfered(a, b, 0.0f);
+  FillBand(dl, band, a.y, a.y + h * 0.22f, k.strip_top, k.strip_upper);
+  FillBand(dl, band, a.y + h * 0.22f, a.y + h * 0.55f, k.strip_upper, k.strip_lower);
+  FillBand(dl, band, a.y + h * 0.55f, b.y, k.strip_lower, k.strip_bottom);
+  dl->AddRectFilled(a, ImVec2(b.x, a.y + 2 * s), k.strip_edge);
+  dl->AddRectFilled(ImVec2(a.x, a.y + h * 0.38f), ImVec2(b.x, a.y + h * 0.38f + 2 * s), k.strip_line);
+  const float cy = a.y + h * 0.5f;
+
+  // Hints on the left: the key in white, then what it does.
+  float x = a.x + 32 * s;
+  const float hint = 13 * s;
+  for (const auto& [key, action] : k.keys) {
+    ShadowText(dl, config_.fonts.bold, hint, ImVec2(x, cy - hint * 0.5f), k.hint_strong, key.c_str());
+    x += config_.fonts.bold->CalcTextSizeA(hint, FLT_MAX, 0.0f, key.c_str()).x + 4 * s;
+    ShadowText(dl, config_.fonts.regular, hint, ImVec2(x, cy - hint * 0.5f), k.hint, action.c_str());
+    x += config_.fonts.regular->CalcTextSizeA(hint, FLT_MAX, 0.0f, action.c_str()).x + 16 * s;
+  }
+
+  // Quit, Save and PLAY on the right.
+  const float play_w = 170 * s, play_h = 52 * s, bw = 100 * s, bh = 40 * s, gap = 12 * s;
+  const float play_x = b.x - 32 * s - play_w, save_x = play_x - gap - bw, quit_x = save_x - gap - bw;
+  ImGui::SetCursorScreenPos(ImVec2(quit_x, cy - bh * 0.5f));
+  if (GlossButton(k, "Quit##strip", ImVec2(bw, bh), false, config_.fonts.regular, 19 * s, s, true, true)) want_quit_ = true;
+  ImGui::SetCursorScreenPos(ImVec2(save_x, cy - bh * 0.5f));
+  if (GlossButton(k, "Save##strip", ImVec2(bw, bh), false, config_.fonts.regular, 19 * s, s, false, true)) Save();
+  ImGui::SetCursorScreenPos(ImVec2(play_x, cy - play_h * 0.5f));
+  const PlayCheck check = config_.can_play ? config_.can_play() : PlayCheck{};
+  {
+    const ImVec2 pa = ImGui::GetCursorScreenPos(), pb(pa.x + play_w, pa.y + play_h);
+    const bool clicked = ImGui::InvisibleButton("##play", ImVec2(play_w, play_h));
+    const bool hot = ImGui::IsItemHovered() || (ImGui::IsItemFocused() && ImGui::GetIO().NavVisible);
+    if (check.ok) Glow(dl, pa, pb, 14 * s, k.primary_glow, (hot ? 14 : 10) * s);
